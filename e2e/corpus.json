{
  "description": "E2E corpus including Microsoft Edge Markov article cases (iloveyou / ichliebedich / alphabet). Expectations use max_label (label must not be stronger).",
  "reference": "https://microsoftedge.github.io/edgevr/posts/Using-Markov-model-for-password-complexity-estimation-in-microsoft-edge/",
  "cases": [
    {
      "id": "edge_iloveyou",
      "password": "iloveyou",
      "tags": ["edge-article", "phrase"],
      "expect": { "max_label": "weak" }
    },
    {
      "id": "edge_ichliebedich",
      "password": "ichliebedich",
      "tags": ["edge-article", "multilingual", "de"],
      "expect": { "max_label": "weak", "reasons_any": ["known_from_training"] }
    },
    {
      "id": "edge_alphabet",
      "password": "abcdefghijklmnopqrstuvwxyz",
      "tags": ["edge-article", "sequential"],
      "expect": { "max_label": "weak", "reasons_any": ["sequential_run"] }
    },
    {
      "id": "edge_alphabet_upper",
      "password": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      "tags": ["edge-article", "sequential"],
      "expect": { "max_label": "weak", "reasons_any": ["sequential_run"] }
    },
    {
