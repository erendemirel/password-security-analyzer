<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Psa</RootNamespace>
    <AssemblyName>PasswordSecurityAnalyzer</AssemblyName>
    <PackageId>PasswordSecurityAnalyzer</PackageId>
    <Version>0.1.0</Version>
    <Authors>Password Security Analyzer Contributors</Authors>
    <Description>Advisory password strength analyzer (P/Invoke → psa-ffi). Does not authorize accounts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/erendemirel/password-security-analyzer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/erendemirel/password-security-analyzer</PackageProjectUrl>
    <PackageTags>password;security;strength;advisory</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Smoke/**" />
    <None Remove="Smoke/**" />
    <EmbeddedResource Remove="Smoke/**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>
</Project>
